@using Microsoft.AspNetCore.Http
@model List<Javapunk.Models.Modules>

@{
    ViewData["Title"] = "Index";
}
<div class="modulesAndQuiz">
    <div class="container main-box centered">
        <h2>Choose a module!</h2>
        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <div class="text-success">You are logged in as admin.</div>
            <a class="btn btn-secondary" asp-action="Create">Add new module</a>
            <a class="btn btn-secondary" asp-controller="Admin" asp-action="Logout">Logout</a>
        }
        <p>Score at least 60 points to unlock the next module</p>
        <div class="module-path">
            @foreach (var module in Model)
            {
                <a class="btn btn-primary module-button @(ViewBag.LastCompletedModule + 1 < module.Id ? "disabled-module" : "")"
                   asp-controller="Quiz"
                   asp-action="Start"
                   asp-route-moduleId="@module.Id"
                   asp-route-userId="@ViewBag.UserId"                   
                >
                    @module.Module_name
                </a>
            }
        </div>
        <div style="height: 15px"></div>
        <a class="btn btn-secondary-custom" asp-controller="Menu" asp-action="Index">Back to Menu</a>
    </div>
</div>