@{
    ViewData["Title"] = "AdminView";
}
<div class="modulesAndQuiz">
    <div class="container main-box centered">
        <h1>Edit modules</h1>
        <a asp-controller="Modules" asp-action="Create" class="btn btn-primary optionbtn">Make your own module!</a>
        <a asp-controller="Modules" asp-action="EditList" class="btn btn-primary optionbtn">Edit modules</a>
        <a asp-controller="Modules" asp-action="DeleteIndex" class="btn btn-primary optionbtn">Delete modules</a>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-primary optionbtn">Back to main menu</a>
    </div>
</div>