@model List<Javapunk.Models.Modules>

@{ 
    ViewData["Title"] = "DeleteIndex";
}

<div class="modulesAndQuiz">
    <div class="container main-box">
        <h2>Delete Modules</h2>
        <div class="form-group">
            <ul class="question-list">
                @foreach (var module in Model)
                {
                    <li class="question-item">
                        <p>@module.Module_name</p>

                        <a class="btn btn-secondary-custom"
                           asp-controller="Modules"
                           asp-action="Delete"
                           asp-route-id="@module.Id">
                            Delete
                        </a>
                    </li>
                }
            </ul>
            <div class="question-actions">
                <a class="btn btn-primary"
                   asp-controller="Modules"
                   asp-action="AdminView">
                    Back to options
                </a>
            </div>
        </div>
    </div>
</div>