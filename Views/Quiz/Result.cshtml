@{
    ViewData["Title"] = "Quiz Result";
}
<style>
body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: url('/images/JavaPunkBakgrunn.png');
        background-size: cover;
        background-position: center;
        filter: blur(8px) brightness(0.7);
        z-index: 0;
   }
    
    .Result-Container {
        font-family: 'PixelDigilove', sans-serif;
        color: #f7e40f;
        position: relative;
        z-index: 1;
        background-color: #544C70CC;
        padding: 20px;
        border-radius: 10px;
        max-width: 600px;
        margin: 40px auto;
    }
</style>

<div class="Result-Container">
<h2>Quiz complete!</h2>

<p>Your score: @ViewBag.Score</p>

<a asp-controller="Modules"
   asp-action="Index"
   asp-route-userId="@ViewBag.UserId">
   Back to modules
</a>
</div>
