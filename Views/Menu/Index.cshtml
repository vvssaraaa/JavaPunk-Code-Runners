@{
    ViewData["Title"] = "Index";
}
<div class="container main-box main-menu-container centered">
    <h1>Main Menu</h1>
    @if (Context.Session.GetString("IsLoggedIn") == "true")
    {
        <div class="log-in-success">
        @if (Context.Session.GetString("IsAdmin") == "true")

        {
             <div class="text-success-custom"> You are logged in as admin.</div>
             <a class="btn btn-secondary-custom" asp-controller="Admin" asp-action="Logout">Log out</a>

        }
        else
        {
            <div class="text-success-custom">You are logged in as @Context.Session.GetString("User_name").</div>
            <a class="btn btn-secondary-custom" asp-controller="Login" asp-action="Logout">Log out</a>

        }
        </div>
    }
    else
    {
        <p>You are not logged in, and your progress will not be saved. Click the button below to be redirected to the log in page.</p>
        <a class="btn btn-secondary" asp-controller="Login" asp-action="Index">Log in</a>
    }
    <a asp-controller="Modules" asp-action="Index" asp-route-userId="@Context.Session.GetInt32("UserId")" class="btn btn-primary optionbtn">Modules</a>
    <a asp-controller="Quiz" asp-action="StartExam" class="btn btn-primary optionbtn">Exam</a>


    @if (ViewBag.IsAdmin == true)
    {
        <a asp-controller="AdminModules" asp-action="Index" class="btn btn-primary optionbtn">Module options</a>
        <a asp-controller="Questions" asp-action="Index" class="btn btn-primary optionbtn">Question options</a>
    }
</div>
