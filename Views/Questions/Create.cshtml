@model IEnumerable<Questions>

@{
    ViewData["Title"] = "Create";
}

<div class="container main-box">
    <h2>Create Question</h2>

    <form asp-action="Create" method="post">
         <div class="form-group">
            <label for="Modules">Module (1-5)</label>
            <input type="text" inputmode="numeric" class="form-control" id="Modules" name="Modules" required />
        </div>
        <div class="form-group">
            <label for="QuestionText">Question Text</label>
            <input type="text" class="form-control" id="QuestionText" name="QuestionText" required />
        </div>
        <div class="form-group">
            <label for="CorrectAnswer">Correct Answer</label>
            <input type="text" class="form-control" id="CorrectAnswer" name="CorrectAnswer" required />
        </div>
        <div class="form-group">
            <label for="WrongAnswer1">Wrong Answer 1</label>
            <input type="text" class="form-control" id="WrongAnswer1" name="WrongAnswer1" required />
        </div>
        <div class="form-group">
            <label for="WrongAnswer2">Wrong Answer 2</label>
            <input type="text" class="form-control" id="WrongAnswer2" name="WrongAnswer2" required />
        </div>
        <div class="form-group">
            <label for="WrongAnswer3">Wrong Answer 3</label>
            <input type="text" class="form-control" id="WrongAnswer3" name="WrongAnswer3" required />
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>

    
    <p>
        <a class="btn btn-secondary"
        asp-controller="Questions"
        asp-action="Index">Back to options</a>
    </p>

</div>