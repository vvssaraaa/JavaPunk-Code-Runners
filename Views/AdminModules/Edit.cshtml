@model Javapunk.Models.Modules

@{
    ViewData["Title"] = "Edit Module";
}

<div class="modulesAndQuiz">
    <div class="container main-box">
        <h2>Edit Module</h2>

        <form asp-action="Edit" method="post" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="Module_name">Module name</label>
                <input asp-for="Module_name" class="form-control" required />
                <span asp-validation-for="Module_name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>

        <p>
            <a class="btn btn-primary"
               asp-controller="AdminModules"
               asp-action="Index">Back to options</a>
        </p>
    </div>
</div>